# -- generated: cache/ holds frame-level features built from the match data -------------------
# Only the four saved models (trained on DFL and Metrica, no match data) are committed.
cache/*
!cache/dfl/
cache/dfl/*
!cache/dfl/poss_model.pkl
!cache/dfl/poss_model_C.pkl
!cache/dfl/poss_model_C_ctx.pkl
!cache/dfl/dead_players_fair_model.pkl

# -- generated: full-match label files and reports --------------------------------------------
# A submission is rebuilt by `python scripts/make_hybrid.py --final`; its SHA-256 is in the README.
submissions/
reports/
*.npz

